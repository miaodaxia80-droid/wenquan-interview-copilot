# 服务端配置；不要把真实密钥放进 web/ 或提交到 Git。
HOST=127.0.0.1
PORT=8787
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
MODEL_API_KEY=
MODEL_NAME=deepseek-v4.1-flash
MODEL_STREAM=true
MODEL_THINKING=disabled
MODEL_REPAIR=true
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
# 仅使用可信的插件页面来源；不记录访谈正文和密钥。
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:4174,tauri://localhost,http://tauri.localhost,null
# Desktop Studio 的插件页面会使用随机回环端口。
ALLOW_LOOPBACK_ORIGINS=true
# 云端部署必须填写至少 32 字符的随机访问码，并设置 HOST=0.0.0.0。
# 访问码与上游服务密钥分开；不写入公开安装包、URL 或访谈导出。
# 本项目个人免配置包按用户要求从忽略的 .env.connection.json 注入访问码，仅供本人使用。
GATEWAY_TOKEN=
# 云端只提供 API，设为 false；本机开发保留 true。
SERVE_WEB=true
# 手机 WebView 来源可能变化。云端可设 true，但仅在 GATEWAY_TOKEN 有效时启用；
# HTTP 与 WebSocket 仍分别执行鉴权，CORS 预检本身不授予访问权限。
ALLOW_TOKEN_ORIGINS=false

# 推荐：火山 Agent Plan 套餐专用 ASR，密钥仅在后端。
ASR_PROVIDER=volcengine
VOLC_ASR_API_KEY=
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_async
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# 仅后端导入文件的兼容 HTTP 转写使用 ffmpeg；原生 Opus 流式采集无需转码。
FFMPEG_PATH=ffmpeg

# 合并到项目本机 .env；请勿复制到 web/ 或提交真实 Key。
ASR_PROVIDER=volcengine
VOLC_ASR_API_KEY=
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_async
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
FFMPEG_PATH=ffmpeg
# 文本模型也使用 Agent Plan 专用网关；不要使用按量计费 /api/v3。
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
MODEL_API_KEY=
MODEL_NAME=deepseek-v4.1-flash
MODEL_STREAM=true
MODEL_THINKING=disabled
MODEL_REPAIR=true
